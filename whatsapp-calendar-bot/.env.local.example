# ---------------------------------------------------------------------------
# WhatsApp Cloud API  (developers.facebook.com -> your app -> WhatsApp -> API Setup)
# ---------------------------------------------------------------------------
# Any random string you choose; retyped into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
# App Settings -> Basic -> App Secret. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=your-meta-app-secret
# IMPORTANT: use a System User token (never expires), not the 24-hour temp token.
WHATSAPP_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Optional: bump when Meta retires the pinned Graph version.
# WHATSAPP_GRAPH_VERSION=v23.0

# Comma-separated allowlist of senders permitted to create events.
# Digits only or +-prefixed, both work. NOT optional: the webhook is public.
ALLOWED_WA_NUMBERS=972501234567

# ---------------------------------------------------------------------------
# Google Calendar  (console.cloud.google.com -> APIs & Services -> Credentials)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match the Authorized redirect URI on the OAuth client exactly.
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback
# Optional: defaults to the account's primary calendar.
GOOGLE_CALENDAR_ID=primary
# Optional: skips the DB and uses this refresh token directly.
# GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Gemini  (aistudio.google.com -> Get API key)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Optional override; defaults to gemini-flash-lite-latest.
# GEMINI_MODEL=gemini-flash-lite-latest

# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App behaviour
# ---------------------------------------------------------------------------
# Guards /api/auth/google so only you can (re)connect the calendar.
SETUP_SECRET=another-random-string
DEFAULT_TIMEZONE=Asia/Jerusalem
# How long a half-finished appointment waits for your answer.
DRAFT_TTL_MINUTES=30
